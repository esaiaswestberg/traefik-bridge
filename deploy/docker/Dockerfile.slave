FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/bridge-slave ./cmd/bridge-slave

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/bridge-slave /usr/local/bin/bridge-slave
ENTRYPOINT ["/usr/local/bin/bridge-slave"]
