FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/bridge-slave ./cmd/bridge-slave

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/bridge-slave /usr/local/bin/bridge-slave
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/bridge-slave"]
