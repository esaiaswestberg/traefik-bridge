# Copy values into your shell or an untracked .env file. Never commit this file
# with real credentials.
BRIDGE_MASTER_ADDRESS=master.internal.example:9443
BRIDGE_DATA_ADDRESS=slave.internal.example:9444
BRIDGE_MASTER_SERVER_NAME=bridge-master
# Existing Docker network on Host 1 used by Traefik and generated proxies.
BRIDGE_DOCKER_NETWORK=bridge-proxy
# Absolute path to ca.crt, slave.crt, slave.key, and route-signing.key on Host 2.
BRIDGE_SLAVE_CREDENTIALS_DIR=/secure/bridge-slave-credentials
